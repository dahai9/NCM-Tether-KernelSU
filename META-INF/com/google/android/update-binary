#!/sbin/sh

TMPDIR=/dev/tmp
PERSISTDIR=/sbin/.magisk/mirror/persist

# Magisk Module Installer Functions
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo "ui_print $1" > /proc/self/fd/$OUTFD
  echo "ui_print" > /proc/self/fd/$OUTFD
}

set_perm() {
  chown $2:$3 $1
  chmod $4 $1
  [ -z "$5" ] && chcon u:object_r:system_file:s0 $1 || chcon $5 $1
}

set_perm_recursive() {
  find $1 -type d 2>/dev/null | while read dir; do
    set_perm $dir $2 $3 $4 $6
  done
  find $1 -type f -o -type l 2>/dev/null | while read file; do
    set_perm $file $2 $3 $5 $6
  done
}

abort() {
  ui_print "$1"
  exit 1
}

# Check ncm.0 support
if [ ! -d /config/usb_gadget/g1/functions/ncm.0 ]; then
  abort "! ncm.0 function not found on this device"
fi

MODPATH=/data/adb/modules/ncm-tether
[ -d "$MODPATH" ] && rm -rf "$MODPATH"

ui_print "- Extracting module files..."
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2

ui_print "- Setting permissions..."
set_perm_recursive $MODPATH 0 0 0755 0644
set_perm $MODPATH/service.sh 0 0 0755
set_perm $MODPATH/post-fs-data.sh 0 0 0755

ui_print "- Done! Reboot to activate NCM tethering"
